# ─── PostgreSQL ───
POSTGRES_USER=kinderlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kinderlog
# Host port (5432 matches container port)
POSTGRES_HOST_PORT=5432

# ─── Connection strings ───
# Host is the compose SERVICE NAME (db / redis), never localhost.
DATABASE_URL=postgresql+psycopg://kinderlog:change-me@db:5432/kinderlog
REDIS_URL=redis://redis:6379/0
# Redis slot 0 = job queue, slot 1 = results
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Security ───
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string
JWT_SECRET_KEY=change-me-to-a-random-32-byte-string

# ─── MinIO (Object Storage) ───
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
# MinIO Console: http://localhost:9001
# MinIO API: http://localhost:9000
MINIO_ENDPOINT=minio:9000
# URL để sinh audio_url cho client/worker. Để trống = dùng MINIO_ENDPOINT.
# PHẢI set khi Celery worker chạy ngoài Docker (ví dụ pod RunPod), vì worker
# không phân giải được hostname "minio" của docker-compose.
# MINIO_PUBLIC_URL=http://<VPS_IP>:9000
MINIO_BUCKET=audio
MINIO_SECURE=false

# ─── Added in later sprints (leave blank for now) ───
# GEMINI_API_KEY=
# Firebase service account JSON — đặt file trong backend/ (đã gitignore).
# Dùng đường dẫn trong container vì backend/ được mount vào /app.
# FIREBASE_CREDENTIALS_PATH=/app/kinderlog_firebase_service.json

# ─── SMTP Email (Gmail / Mail Server) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
