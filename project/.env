 # ── PostgreSQL ──
  POSTGRES_USER=kinderlog
  POSTGRES_PASSWORD=kinderlog
  POSTGRES_DB=kinderlog
  POSTGRES_HOST_PORT=5433

# ── Connection strings ──
  DATABASE_URL=postgresql+psycopg://kinderlog:kinderlog@db:5432/kinderlog
  REDIS_URL=redis://redis:6379/0
  CELERY_BROKER_URL=redis://redis:6379/0
  CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Security ──
  SECRET_KEY=dev-secret-key-change-me