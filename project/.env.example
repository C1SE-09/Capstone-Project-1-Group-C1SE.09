# ─── PostgreSQL ───
POSTGRES_USER=kinderlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kinderlog
# Host port. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# ─── Connection strings ───
# Host is the compose SERVICE NAME (db / redis), never localhost.
DATABASE_URL=postgresql+psycopg://kinderlog:change-me@db:5432/kinderlog
REDIS_URL=redis://redis:6379/0
# Redis slot 0 = job queue, slot 1 = results
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Security ───
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string

# ─── Added in later sprints (leave blank for now) ───
# GEMINI_API_KEY=
# FIREBASE_CREDENTIALS_PATH=